#!/usr/bin/env bash

echo "Starting main script..."
echo "TTT - $(date)"

#
# Start Jupyter server
#

# Set the working directory
workdir="<%= context.working_directory %>"

# If the working directory does not exist, set it to $HOME
if [[ -z "$workdir" ]] || [[ ! -d "$workdir" ]]; then
    echo "Working directory '$workdir' does not exist or is not set. Setting it to $HOME."
    workdir="$HOME"
fi

echo "Using working directory: $workdir"
cd $workdir

#
# Start Jupyter Notebook Server
#

# Purge the module environment to avoid conflicts
module purge

# Load the require modules
# module load jupyter
module load <%= context.module %>
module list
export SINGULARITY_BIND="/cluster/tufts${SINGULARITY_BIND:+,$SINGULARITY_BIND}"
export APPTAINER_BIND="/cluster/tufts${APPTAINER_BIND:+,$APPTAINER_BIND}"

# List available kernels for debugging purposes
set -x
jupyter kernelspec list
{ set +x; } 2>/dev/null
echo "TTT - $(date)"

# Launch the Jupyter server
set -x
/cluster/tufts/apps/manual/9/x86_64/jupyter/4.5.0/bin/jupyter <%= context.mode == "1" ? 'lab' : 'notebook' %> --config="${CONFIG_FILE}"
